# Time zone used by the source and API containers
TZ=Europe/Moscow

# Internal Docker Compose service URLs
PROXY_SOURCE_URL=http://proxy-source:8080/proxies.json
REDIS_URL=redis://redis:6379/0

# Replace with a long, unique secret before exposing the API
API_KEY=change-me-to-a-long-random-secret

# Proxy cache refresh interval, in seconds
CACHE_UPDATE_INTERVAL=300
